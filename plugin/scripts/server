#!/bin/sh
# Starts the Canvas Study MCP server (plugin/server, run by uvx). A student
# installs nothing by hand: when this machine has no uv, the official installer
# (pinned) puts it in the plugin's data folder, without touching PATH or shell
# profiles. Everything it prints goes to stderr: stdout is the MCP channel.
#
#   server                   the MCP server (what .mcp.json runs)
#   server --download-model  get uv, the server's packages and the search model
#   server --version         get uv and the server's packages
set -eu

UV_VERSION=0.9.28
PLUGIN_DIR="$(cd "$(dirname "$0")/.." && pwd)"
DATA="${CLAUDE_PLUGIN_DATA:-$HOME/.canvas-study}"
UV_DIR="$DATA/uv"

find_uvx() {
  for candidate in "$(command -v uvx 2>/dev/null || true)" "$HOME/.local/bin/uvx" "$HOME/.cargo/bin/uvx" "$UV_DIR/uvx"; do
    if [ -n "$candidate" ] && [ -x "$candidate" ]; then
      echo "$candidate"
      return 0
    fi
  done
  return 1
}

if ! UVX="$(find_uvx)"; then
  echo "canvas-study: installing uv $UV_VERSION into $UV_DIR" >&2
  mkdir -p "$UV_DIR"
  curl -LsSf "https://astral.sh/uv/$UV_VERSION/install.sh" | env UV_UNMANAGED_INSTALL="$UV_DIR" sh >&2
  UVX="$UV_DIR/uvx"
fi

# Real copies, not hard links (uv's default on Linux): recent nltk, which
# llama-index uses, refuses to open a multiply-linked file.
export UV_LINK_MODE=copy
exec "$UVX" --from "$PLUGIN_DIR/server" canvas-study-mcp "$@"
